local chatB = peripheral.find("chatBox")

local function sendMessage(msg)
    -- local splitMessage = string.split(msg, " ")
    -- if #splitMessage < 1 then return end

    print("Sending message: " .. msg)
    chatB.sendMessage(msg, "Dave", "<>", "cyan")
end

if not chatB then
    print("No chat peripheral found.")
    print("Please connect a chat peripheral to use this program.")
    print("Exiting...")
    os.exit()
end

term.clear()
term.setCursorPos(1, 1)
print("Chat peripheral found. Starting chat program...")

while true do
    local input = read()
    if input and input:match("%S") then
        sendMessage(input)
        os.sleep(1)
    end
end

