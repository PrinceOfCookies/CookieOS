local chatB = peripheral.find("chat_box")
local function sendMessage(msg)
    print("Sending message: " .. msg)
    chatB.sendMessage(msg, "Dave", "<>")
end

if not chatB then
    print("No chat peripheral found.")
    print("Please connect a chat peripheral to use this program.")
    print("Exiting...")
    return
end

term.clear()
term.setCursorPos(1, 1)
print("Chat peripheral found. Starting chat program...")
while true do
    local input = read()
    if input and input:match("%S") then
        cosUtils.safeRun(function() sendMessage(input) end, function(err) print("Error sending message: " .. err) end)
        os.sleep(1)
    end
end