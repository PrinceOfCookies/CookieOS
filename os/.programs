shell.run("cd /")
cosUtils.resetScreen(term)
local drive = peripheral.find("drive")
local speaker = peripheral.find("speaker")
local chat = peripheral.find("chat_box")
local monitor = peripheral.find("monitor")
local playerTracker = peripheral.find("player_detector")

local w, h = term.getSize()
-- Draw Menu
local numOp = 1

-- GUI
cosUtils.resetScreen(term)

local lastrefresh = ""

local invisibleWindow = window.create(term.current(), 1, 1 + 2, w, h, false)

local playMusic = colors.white
local chatColor = colors.white
local trackerColor = colors.white

if not drive then
    osEditColor = colors.red
elseif not drive.isDiskPresent() then
    osEditColor = colors.red
elseif fs.list("disk")[1] then
    osEditColor = colors.red
elseif drive.getDiskLabel() then
    osEditColor = colors.red
end

if not speaker then
    playMusic = colors.red
end

if not chat then
    chatColor = colors.red
end

if not chat or not monitor or not playerTracker then
    trackerColor = colors.red
end

-- Define menu items
local menuItemsMock = {
    "",
    "Programs",
    "",
    numOp == 1 and "[ File Explorer ]" or "File Explorer",
    numOp == 2 and "[ Play Music    ]" or "Play Music   ",
    numOp == 3 and "[ Chat          ]" or "Chat         ",
    numOp == 4 and "[ Player Tracker]" or "Player Tracker",
    numOp == 5 and "[ Back          ]" or "Back         "
}


local function drawFrontEnd(device)
    invisibleWindow.setVisible(false)
    invisibleWindow.clear()

    local menuItems = {
        "",
        "Programs",
        "",
    numOp == 1 and "[ File Explorer ]" or "File Explorer",
    numOp == 2 and "[ Play Music    ]" or "Play Music   ",
    numOp == 3 and "[ Chat          ]" or "Chat         ",
    numOp == 4 and "[ Player Tracker]" or " Player Tracker",
    numOp == 5 and "[ Back          ]" or "Back         "
    }

    local colorss = {
        colors.white,
        colors.white,
        colors.white,
        colors.white,
        playMusic,
        chatColor,
        trackerColor,
        colors.white
    }

    cosUtils.centerPrintTable((h / 2) / 2, w, menuItems, numOp, false, colors.black, true, invisibleWindow, colorss)
    invisibleWindow.setVisible(true)


    _, lastrefresh = cosUtils.getTime("12", true)
    return lastrefresh
end

local drawMenu = cosUtils.drawMenu

-- Display here
drawMenu(term)
drawFrontEnd(term)

-- Thanks shrekshellraiser on discord for help with this
local timerID = os.startTimer(1)
while true do
    local e, key = os.pullEvent()
    if e == "timer" and key == timerID then
        local _, minutee = cosUtils.getTime("12", true)

        if lastrefresh ~= minutee then
            drawMenu(term)
            drawFrontEnd(term)
        end
        timerID = os.startTimer(1)
    elseif e == "key" then
        numOp = cosUtils.menuKeyUpDownManagement(key, numOp, drawMenu, drawFrontEnd, #menuItemsMock - 5, 1)

        drawMenu(term)
        drawFrontEnd(term)

        if key == keys.enter then
            break -- Do this outside of the `menuKeyUpDownManagement` func due to the break
        end
    end
end

if numOp == 1 then
    shell.run("os/programs/fileExplorer")
elseif numOp == 2 then
    if playMusic == colors.red then
        shell.run("os/.programs")
    end

    shell.run("os/programs/playMusic")
elseif numOp == 3 then
    if chatColor == colors.red then
        shell.run("os/.programs")
    end

    shell.run("os/programs/chat")
elseif numOp == 4 then
    if trackerColor == colors.red then
        shell.run("os/.programs")
    end

    shell.run("os/programs/playertracker")
elseif numOp == 5 then
    shell.run(".menu")
else
    cosUtils.logToOS("Invalid option selected." .. numOp)
end
